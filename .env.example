# Copy to .env and fill in. NEVER commit .env — the repo is public.

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
AWS_PROFILE=default

# --- Models (PROTOCOLS.md P4: tune on Haiku, validate on Sonnet) ---
DOCKET_MODEL_TRIAGE=anthropic.claude-haiku-4-5
DOCKET_MODEL_EXTRACT=anthropic.claude-haiku-4-5
DOCKET_MODEL_BRIEF=anthropic.claude-sonnet-5

# --- Target jurisdiction ---
DOCKET_CITY=oakland

# --- Caching (PROTOCOLS.md P4) ---
DOCKET_CACHE_DIR=./cache
DOCKET_LLM_CACHE=1

# --- Geocoding ---
# Nominatim requires a real contact per its usage policy
NOMINATIM_USER_AGENT=docket-hackathon/0.1 (your-email@example.com)

# --- SAFETY (PROTOCOLS.md P7) ---
# Must stay 1 for all development and demos.
# Setting this to 0 permits real submissions to city clerks. Do not.
DOCKET_DEMO_MODE=1
